-- VERBESSERTES VELOCITY-SYSTEM MIT HISTORY-BUFFER
local VelocityHistory = {} -- { [userId] = { positions = {}, times = {} } }
local HISTORY_SIZE = 6    -- Anzahl der gespeicherten Frames für EMA

-- Liest den echten Ping aus dem Stats-Service
local function GetRealPing()
    local ok, ping = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and ping and ping > 0 then
        return ping / 1000 -- ms → Sekunden
    end
    return 0.08 -- Fallback
end

-- Exponential Moving Average über die letzten N Positionen
-- Verhindert, dass ein einzelner "Ausreißer-Frame" die Prediction zerstört
local function GetSmoothedVelocity(player)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return Vector3.zero end

    local pid = player.UserId
    local now = tick()
    local pos = root.Position

    -- History initialisieren
    if not VelocityHistory[pid] then
        VelocityHistory[pid] = { positions = {}, times = {} }
    end

    local hist = VelocityHistory[pid]
    table.insert(hist.positions, pos)
    table.insert(hist.times, now)

    -- Buffer begrenzen
    while #hist.positions > HISTORY_SIZE do
        table.remove(hist.positions, 1)
        table.remove(hist.times, 1)
    end

    -- Brauchen mindestens 2 Einträge für eine Velocity
    if #hist.positions < 2 then
        return Vector3.zero
    end

    -- Rohe Velocity aus ältestem → neuestem Eintrag (stabilster Wert)
    local oldestPos = hist.positions[1]
    local oldestTime = hist.times[1]
    local dt = now - oldestTime

    if dt < 0.001 then return Vector3.zero end

    local rawVelocity = (pos - oldestPos) / dt

    -- Plausibilitätsprüfung: Roblox-Spieler bewegen sich max ~100 studs/s
    -- Alles darüber ist ein Netzwerk-Ausreißer → ignorieren
    local speed = rawVelocity.Magnitude
    if speed > 120 then
        -- Fallback: Nur letzten Frame nutzen
        local prevPos = hist.positions[#hist.positions - 1]
        local prevTime = hist.times[#hist.times - 1]
        local shortDt = now - prevTime
        if shortDt > 0.001 then
            local shortVel = (pos - prevPos) / shortDt
            if shortVel.Magnitude <= 120 then
                return shortVel
            end
        end
        return Vector3.zero -- Ausreißer komplett verwerfen
    end

    return rawVelocity
end

-- Räumt Velocity-History für Spieler auf, die nicht mehr im Spiel sind
local function CleanupHistory()
    for pid, _ in pairs(VelocityHistory) do
        local found = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p.UserId == pid then found = true break end
        end
        if not found then VelocityHistory[pid] = nil end
    end
end
task.spawn(function()
    while true do task.wait(10) CleanupHistory() end
end)

local function GetClosestTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local shortest = getgenv().LockTolerance
    local target = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local hum = player.Character:FindFirstChild("Humanoid")
            local hitPart = player.Character:FindFirstChild(getgenv().HitPart)
            if hum and hum.Health > 0 and hitPart then
                local screenPos, visible = Camera:WorldToViewportPoint(hitPart.Position)
                if visible then
                    local dist = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                    if dist < shortest then
                        shortest = dist
                        target = player
                    end
                end
            end
        end
    end
    return target
end

local function IsTargetValid()
    if not TargetPlr or not TargetPlr.Character then return false end
    local hum = TargetPlr.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not TargetPlr.Character:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local function GetPredictedPosition()
    if not (IsLocked and IsTargetValid()) then return nil end

    local part = TargetPlr.Character:FindFirstChild(getgenv().HitPart)
    if not part then return nil end

    -- Velocity aus dem stabilen History-Buffer
    local smoothVel = GetSmoothedVelocity(TargetPlr)

    -- Echter Ping aus dem Stats-Service
    local ping = GetRealPing()

    -- Gesamt-Prediction: Nutzer-Wert + halber Ping (round-trip → one-way)
    local totalPrediction = getgenv().Prediction + (ping * 0.5)

    -- Kap bei max 0.4s um wilde Schüsse bei Ping-Spikes zu verhindern
    totalPrediction = math.clamp(totalPrediction, 0.05, 0.4)

    return part.Position + (smoothVel * totalPrediction)
end

