-- 🎯 PURE SILENT AIM (Q-LOCK)
-- Kein FOV, Kein Intro. Drück Q -> Aimlock auf Maus-Target.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

-- === STATUS ===
local isLocked = false
local targetPlr = nil
local targetPart = nil
local predictionPos = nil
local Data = {} -- Velocity Cache

-- === GUI (Status Anzeige) ===
local gui = Instance.new("ScreenGui")
gui.Name = "SilentStatus"
gui.ResetOnSpawn = false
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local label = Instance.new("TextLabel")
label.Size = UDim2.new(0, 200, 0, 40)
label.Position = UDim2.new(0.5, -100, 0.85, 0)
label.BackgroundTransparency = 1
label.Text = ""
label.Font = Enum.Font.GothamBlack
label.TextSize = 20
label.TextStrokeTransparency = 0.5
label.Parent = gui

-- === HIGHLIGHT ===
local hl = Instance.new("Highlight")
hl.Name = "SilentHL"
hl.FillColor = Color3.fromRGB(255, 0, 0)
hl.FillTransparency = 0.5
hl.OutlineColor = Color3.fromRGB(255, 255, 255)
hl.OutlineTransparency = 0
hl.Enabled = false
hl.Parent = game:GetService("CoreGui")

-- === FUNKTIONEN ===

-- Findet den Spieler, der am nächsten am Mauszeiger ist
local function getClosestToMouse()
    local bestDist = math.huge
    local bestTarget = nil
    local bestPart = nil
    local mp = UserInputService:GetMouseLocation()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChild("Humanoid")
            local head = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            if hum and hum.Health > 0 and head and hrp then
                -- Check ob sichtbar (Wallcheck)
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {LocalPlayer.Character, char}
                local ray = Workspace:Raycast(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position), params)
                
                if not ray then -- Wenn kein Hindernis
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - mp).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestTarget = char
                            bestPart = head -- Standard Head
                        end
                    end
                end
            end
        end
    end
    return bestTarget, bestPart
end

-- Berechnet Prediction (Bewegung + Ping)
local function getPrediction(char, part)
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return part.Position end

    -- Velocity Tracking
    local t = tick()
    local vel = hrp.AssemblyLinearVelocity or Vector3.zero
    if not Data[char] then Data[char] = {lastT = t, vel = vel} end
    
    local ping = 0.06
    pcall(function() ping = LocalPlayer:GetNetworkPing() end)
    
    -- Einfache Prediction Formel
    local dist = (part.Position - Camera.CFrame.Position).Magnitude
    local timeToHit = (dist / 1000) + ping
    
    return part.Position + (vel * timeToHit)
end

-- === LOGIK ===

local function toggleLock()
    if isLocked then
        -- Unlocken
        isLocked = false
        targetPlr = nil
        targetPart = nil
        hl.Enabled = false
        label.Text = ""
    else
        -- Suchen & Locken
        local t, p = getClosestToMouse()
        if t and p then
            isLocked = true
            targetPlr = t
            targetPart = p
            hl.Adornee = t
            hl.Enabled = true
            label.Text = "LOCKED: " .. t.Name
            label.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    end
end

-- Update Loop
RunService.RenderStepped:Connect(function()
    if isLocked and targetPlr and targetPlr.Parent then
        local hum = targetPlr:FindFirstChild("Humanoid")
        -- Auto-Unlock wenn tot
        if not hum or hum.Health <= 0 then
            toggleLock()
            return
        end
        -- Position updaten
        predictionPos = getPrediction(targetPlr, targetPart)
    else
        if isLocked then toggleLock() end
    end
end)

-- === HOOKS (Silent Aim Magic) ===
local mt = getrawmetatable(game)
local oldNc = mt.__namecall
local oldIdx = mt.__index
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local m = getnamecallmethod()
    local a = {...}
    
    if isLocked and predictionPos then
        -- Raycast (Guns)
        if m == "Raycast" and self == Workspace then
            if a[1] and a[2] then
                a[2] = (predictionPos - a[1]).Unit * a[2].Magnitude
                return oldNc(self, unpack(a))
            end
        end
        -- Mouse Hit (Tools)
        if self == Mouse and (m == "GetHit" or m == "Hit") then
            return CFrame.new(predictionPos)
        end
    end
    return oldNc(self, ...)
end)

mt.__index = newcclosure(function(self, k)
    if isLocked and predictionPos and self == Mouse then
        if k == "Hit" then return CFrame.new(predictionPos) end
        if k == "Target" then return targetPart end
    end
    return oldIdx(self, k)
end)

setreadonly(mt, true)

-- Input
UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.Q then
        toggleLock()
    end
end)
