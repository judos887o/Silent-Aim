keyBox.FocusLost:Connect(function(enterPressed)
    local input = keyBox.Text:upper():gsub("%s", "")
    if input == "" then
        keyBox.Text = AimKey.Name
        return
    end

    local success, key = pcall(function()
        return Enum.KeyCode[input]
    end)

    if success and key then
        AimKey = key
        keyBox.Text = key.Name
        keyStroke.Color = Color3.fromRGB(0, 255, 80)
        task.delay(0.5, function()
            keyStroke.Color = Color3.fromRGB(80, 80, 80)
        end)
    else
        keyBox.Text = AimKey.Name
        keyStroke.Color = Color3.fromRGB(255, 50, 50)
        task.delay(0.5, function()
            keyStroke.Color = Color3.fromRGB(80, 80, 80)
        end)
    end
end)

local function GetSmoothedVelocity(player)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return Vector3.zero end

    local now = tick()
    local pid = player.UserId

    if LastPositions[pid] and LastTime[pid] then
        local dt = now - LastTime[pid]
        if dt > 0 then
            local vel = (root.Position - LastPositions[pid]) / dt
            LastPositions[pid] = root.Position
            LastTime[pid] = now
            return vel
        end
    end

    LastPositions[pid] = root.Position
    LastTime[pid] = now
    return root.Velocity
end

local function GetClosestTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local shortest = getgenv().LockTolerance
    local target = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hitPart = player.Character:FindFirstChild(getgenv().HitPart)
            if hitPart then
                local screenPos, visible = Camera:WorldToViewportPoint(hitPart.Position)
                if visible then
                    local distance = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                    if distance < shortest then
                        shortest = distance
                        target = player
                    end
                end
            end
        end
    end
    return target
end

local function IsTargetValid()
    if not TargetPlr then return false end
    if not TargetPlr.Character then return false end
    local hum = TargetPlr.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not TargetPlr.Character:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local function GetPredictedPosition()
    if not (IsLocked and IsTargetValid()) then return nil end

    local root = TargetPlr.Character:FindFirstChild("HumanoidRootPart")
    local part = TargetPlr.Character:FindFirstChild(getgenv().HitPart)
    if not root or not part then return nil end

    local smoothVel = GetSmoothedVelocity(TargetPlr)
    local ping = 0.08
    local stats = LP:FindFirstChild("NetworkPing")
    if stats then ping = stats.Value or 0.08 end
    local totalPrediction = getgenv().Prediction + ping

    return part.Position + (smoothVel * totalPrediction)
end

table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if keyBox:IsFocused() then return end
    if input.KeyCode ~= AimKey then return end

    if IsLocked then
        IsLocked = false
        TargetPlr = nil
        label.Text = "Silent Aim | Unlocked"
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
        marker.Visible = false
    else
        TargetPlr = GetClosestTarget()
        if TargetPlr then
            IsLocked = true
            label.Text = "LOCKED → " .. TargetPlr.DisplayName
            label.TextColor3 = Color3.fromRGB(0, 255, 80)
        end
    end
end))

table.insert(Connections, RunService.Heartbeat:Connect(function()
    if IsLocked then
        if not IsTargetValid() then
            task.wait(0.3)
            if not IsTargetValid() then
                local newTarget = GetClosestTarget()
                if newTarget then
                    TargetPlr = newTarget
                    label.Text = "LOCKED → " .. TargetPlr.DisplayName
                    label.TextColor3 = Color3.fromRGB(0, 255, 80)
                else
                    IsLocked = false
                    TargetPlr = nil
                    label.Text = "Target lost | Press key again"
                    label.TextColor3 = Color3.fromRGB(255, 100, 100)
                    marker.Visible = false
                end
            end
        end
    end
end))

table.insert(Connections, RunService.RenderStepped:Connect(function()
    if IsLocked and IsTargetValid() then
        local predPos = GetPredictedPosition()
        if predPos then
            local screenPos, onScreen = Camera:WorldToViewportPoint(predPos)
            marker.Visible = onScreen
            if onScreen then
                marker.Position = UDim2.fromOffset(screenPos.X - 6.5, screenPos.Y - 6.5)
            end
        end
    else
        marker.Visible = false
    end
end))

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if not checkcaller() and IsLocked and self == Mouse then
        local predicted = GetPredictedPosition()
        if predicted then
            if key == "Hit" then
                return CFrame.new(predicted)
            elseif key == "Target" then
                if IsTargetValid() then
                    return TargetPlr.Character:FindFirstChild(getgenv().HitPart)
                end
            end
        end
    end
    return oldIndex(self, key)
end))

getgenv().SilentAim_Q_Destroy = function()
    for _, c in pairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    if gui then gui:Destroy() end
    getgenv().SilentAim_Q_Destroy = nil
end
