--// SILENT AIM CLEAN //--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera
local mouse  = localPlayer:GetMouse()

local FOV_RADIUS       = 90
local HIT_PART         = "Head"
local PREDICTION_AMOUNT = 0.135
local ENABLE_PREDICTION = true

local isAiming    = false
local targetPlayer = nil

local highlight = Instance.new("Highlight")
highlight.Name = "SilentHighlight"
highlight.FillTransparency = 1
highlight.OutlineColor = Color3.new(1, 1, 1)
highlight.OutlineTransparency = 0
highlight.Enabled = false
highlight.Parent = game:GetService("CoreGui")

-- Maus Hook
local mt = getrawmetatable(game)
setreadonly(mt, false)
local oldIndex = mt.__index

mt.__index = function(t, k)
    if t == mouse and (k == "Hit" or k == "Target") and isAiming and targetPlayer then
        local char = targetPlayer.Character
        if not char then return oldIndex(t, k) end
        local part = char:FindFirstChild(HIT_PART)
        if not part then return oldIndex(t, k) end

        local pos = part.Position
        if ENABLE_PREDICTION and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            pos = pos + hrp.Velocity * PREDICTION_AMOUNT
        end

        if k == "Hit" then
            return CFrame.new(pos)
        elseif k == "Target" then
            return part
        end
    end
    return oldIndex(t, k)
end

local function getClosestTarget()
    local closest
    local shortest = FOV_RADIUS

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local part = plr.Character:FindFirstChild(HIT_PART)
            if hum and hum.Health > 0 and part then
                local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = plr
                    end
                end
            end
        end
    end

    return closest
end

-- Q toggelt Silent Aim
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then
        if isAiming then
            isAiming = false
            targetPlayer = nil
            highlight.Adornee = nil
            highlight.Enabled = false
        else
            local t = getClosestTarget()
            if t then
                isAiming = true
                targetPlayer = t
                highlight.Adornee = t.Character
                highlight.Enabled = true
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if isAiming then
        if not targetPlayer or not targetPlayer.Character then
            isAiming = false
            targetPlayer = nil
            highlight.Adornee = nil
            highlight.Enabled = false
            return
        end
        local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            isAiming = false
            targetPlayer = nil
            highlight.Adornee = nil
            highlight.Enabled = false
        end
    end
end)
