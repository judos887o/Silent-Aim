local Shared = getgenv().SchmecktHubPC or {}
getgenv().SchmecktHubPC = Shared

Shared.SilentAim = true
Shared.SilentAimMethod = "QMethod"

local key = "SilentAimQMethod"

Shared.Connections = Shared.Connections or {}
if Shared.Connections[key] then
    for _, conn in pairs(Shared.Connections[key]) do
        pcall(function() conn:Disconnect() end)
    end
end
Shared.Connections[key] = {}

if Shared._QMethodGUI then pcall(function() Shared._QMethodGUI:Destroy() end) end

local PREDICTION = 0.136
local isLocked = false
local targetPlr = nil
local targetPart = nil
local predictionPos = nil
local IsGunEquipped = false

local gui = Instance.new("ScreenGui")
gui.Name = "SilentStatusQ"
gui.ResetOnSpawn = false
gui.Parent = LP:WaitForChild("PlayerGui")
Shared._QMethodGUI = gui

