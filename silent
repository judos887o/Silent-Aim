if getgenv().SilentAim_Q_Destroy then pcall(getgenv().SilentAim_Q_Destroy) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Stats = game:GetService("Stats")

local LP = Players.LocalPlayer
local Mouse = LP:GetMouse()
local Camera = workspace.CurrentCamera

getgenv().Prediction = 0.138
getgenv().HitPart = "HumanoidRootPart"
getgenv().LockTolerance = 160
getgenv().AimKey = Enum.KeyCode.Q

local TargetPlr = nil
local IsLocked = false
local IsBinding = false
local Connections = {}

local PredictionRayParams = RaycastParams.new()
PredictionRayParams.FilterType = Enum.RaycastFilterType.Exclude
PredictionRayParams.IgnoreWater = true

local VelocityHistory = {}
local HISTORY_SIZE = 15
local GRAVITY = Vector3.new(0, -workspace.Gravity, 0)

local function GetRealPing()
    local ok, ping = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return (ok and ping and ping > 0) and (ping / 1000) or 0.07
end

local function IsGrounded(char)
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return true end
    if hum.FloorMaterial ~= Enum.Material.Air then return true end
    PredictionRayParams.FilterDescendantsInstances = {char, LP.Character}
    local res = workspace:Raycast(hrp.Position, Vector3.new(0, -5, 0), PredictionRayParams)
    return res ~= nil
end

local function GetResolvedVelocity(player)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return Vector3.zero, Vector3.zero end

    local pid = player.UserId
    if not VelocityHistory[pid] then
        VelocityHistory[pid] = {pos = {}, vel = {}, t = {}}
    end

    local hist = VelocityHistory[pid]
    local now = tick()
    local rawVel = root.AssemblyLinearVelocity
    local moveDir = hum.MoveDirection
    
    local resolvedVel = rawVel
    if rawVel.Magnitude > 70 or (rawVel.Y > 35 or rawVel.Y < -35) or (rawVel.Magnitude > 1 and moveDir.Magnitude == 0) then
        resolvedVel = moveDir * hum.WalkSpeed
    end

    table.insert(hist.pos, root.Position)
    table.insert(hist.vel, resolvedVel)
    table.insert(hist.t, now)

    if #hist.pos > HISTORY_SIZE then
        table.remove(hist.pos, 1)
        table.remove(hist.vel, 1)
        table.remove(hist.t, 1)
    end

    local avgVel = Vector3.zero
    for i = 1, #hist.vel do
        avgVel = avgVel + hist.vel[i]
    end
    avgVel = avgVel / #hist.vel

    local accel = Vector3.zero
    if #hist.vel > 2 then
        local dt = hist.t[#hist.t] - hist.t[1]
        accel = (hist.vel[#hist.vel] - hist.vel[1]) / dt
    end
    
    if accel.Magnitude > 100 then accel = Vector3.zero end

    return avgVel, accel
end

local function IsTargetValid(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return plr.Character:FindFirstChild(getgenv().HitPart) ~= nil
end

local function GetPredictedPosition()
    if not IsLocked or not IsTargetValid(TargetPlr) then return nil end
    local char = TargetPlr.Character
    local part = char:FindFirstChild(getgenv().HitPart)
    if not part then return nil end

    local pos = part.Position
    local vel, accel = GetResolvedVelocity(TargetPlr)
    local ping = GetRealPing()
    
    local t = getgenv().Prediction + (ping * 0.5)
    local grounded = IsGrounded(char)
    
    local horizontalVel = Vector3.new(vel.X, 0, vel.Z)
    local outPos = pos + (horizontalVel * t) + (0.5 * accel * t * t)

    if not grounded then
        local verticalOffset = (vel.Y * t) + (0.5 * GRAVITY.Y * t * t)
        outPos = Vector3.new(outPos.X, pos.Y + verticalOffset, outPos.Z)
    else
        outPos = Vector3.new(outPos.X, pos.Y, outPos.Z)
    end

    return outPos
end

local function GetClosestTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local shortest = getgenv().LockTolerance
    local target = nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and IsTargetValid(player) then
            local hitPart = player.Character[getgenv().HitPart]
            local screenPos, visible = Camera:WorldToViewportPoint(hitPart.Position)
            if visible then
                local dist = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if dist < shortest then
                    shortest = dist
                    target = player
                end
            end
        end
    end
    return target
end

local gui = Instance.new("ScreenGui", game:GetService("CoreGui"))
local container = Instance.new("TextButton", gui)
container.Name = "MainFrame"
container.Size = UDim2.new(0, 300, 0, 50)
container.Position = UDim2.new(0.5, -150, 0.70, 0)
container.BackgroundTransparency = 0.3
container.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
container.Text = ""
container.AutoButtonColor = false
Instance.new("UICorner", container)

local label = Instance.new("TextLabel", container)
label.Size = UDim2.new(1, 0, 1, 0)
label.Text = "Silent Aim | Press [" .. getgenv().AimKey.Name .. "]"
label.TextColor3 = Color3.new(1, 1, 1)
label.BackgroundTransparency = 1
label.Font = Enum.Font.GothamBold
label.TextSize = 16

local marker = Instance.new("Frame", gui)
marker.Size = UDim2.new(0, 10, 0, 10)
marker.BackgroundColor3 = Color3.new(1, 0, 0)
marker.Visible = false
Instance.new("UICorner", marker).CornerRadius = UDim.new(1, 0)

container.MouseButton1Click:Connect(function()
    IsBinding = true
    label.Text = "Press any key..."
end)

table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gp)
    if IsBinding then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            getgenv().AimKey = input.KeyCode
            IsBinding = false
            label.Text = "Silent Aim | Press [" .. getgenv().AimKey.Name .. "]"
        end
        return
    end
    if gp then return end
    if input.KeyCode == getgenv().AimKey then
        if IsLocked then
            IsLocked = false
            TargetPlr = nil
            label.Text = "Silent Aim | Unlocked"
        else
            TargetPlr = GetClosestTarget()
            if TargetPlr then
                IsLocked = true
                label.Text = "LOCKED: " .. TargetPlr.DisplayName
            end
        end
    end
end))

table.insert(Connections, RunService.RenderStepped:Connect(function()
    if IsLocked and IsTargetValid(TargetPlr) then
        local pred = GetPredictedPosition()
        if pred then
            local screenPos, visible = Camera:WorldToViewportPoint(pred)
            marker.Visible = visible
            marker.Position = UDim2.fromOffset(screenPos.X - 5, screenPos.Y - 5)
        else
            marker.Visible = false
        end
    else
        marker.Visible = false
        if IsLocked and not IsTargetValid(TargetPlr) then
            IsLocked = false
            label.Text = "Target lost"
        end
    end
end))

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if not checkcaller() and IsLocked and self == Mouse then
        if key == "Hit" then
            local pred = GetPredictedPosition()
            if pred then return CFrame.new(pred) end
        elseif key == "Target" then
            if IsTargetValid(TargetPlr) then return TargetPlr.Character[getgenv().HitPart] end
        end
    end
    return oldIndex(self, key)
end))

getgenv().SilentAim_Q_Destroy = function()
    for _, c in pairs(Connections) do c:Disconnect() end
    gui:Destroy()
    VelocityHistory = {}
    getgenv().SilentAim_Q_Destroy = nil
end
