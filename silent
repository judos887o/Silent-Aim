keyBox.FocusLost:Connect(function()
    local input = keyBox.Text:upper():gsub("%s", "")
    if input == "" then keyBox.Text = AimKey.Name return end
    local ok, key = pcall(function() return Enum.KeyCode[input] end)
    if ok and key then
        AimKey = key
        keyBox.Text = key.Name
        keyStroke.Color = Color3.fromRGB(0, 255, 80)
        task.delay(0.5, function() keyStroke.Color = Color3.fromRGB(80, 80, 80) end)
    else
        keyBox.Text = AimKey.Name
        keyStroke.Color = Color3.fromRGB(255, 50, 50)
        task.delay(0.5, function() keyStroke.Color = Color3.fromRGB(80, 80, 80) end)
    end
end)

-- Lock / Unlock
table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gp)
    if gp or keyBox:IsFocused() then return end
    if input.KeyCode ~= AimKey then return end

    if IsLocked then
        IsLocked = false
        TargetPlr = nil
        label.Text = "Silent Aim | Unlocked"
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
        marker.Visible = false
    else
        TargetPlr = GetClosestTarget()
        if TargetPlr then
            IsLocked = true
            label.Text = "LOCKED → " .. TargetPlr.DisplayName
            label.TextColor3 = Color3.fromRGB(0, 255, 80)
        end
    end
end))

-- HEARTBEAT: Kein task.wait() mehr! Saubere Zustandsmaschine
local targetLostTimer = 0
table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
    if not IsLocked then
        targetLostTimer = 0
        return
    end

    if IsTargetValid() then
        targetLostTimer = 0
        return
    end

    -- Ziel ungültig: Timer hochzählen statt task.wait
    targetLostTimer = targetLostTimer + dt

    if targetLostTimer >= 0.3 then
        targetLostTimer = 0
        local newTarget = GetClosestTarget()
        if newTarget then
            TargetPlr = newTarget
            label.Text = "LOCKED → " .. TargetPlr.DisplayName
            label.TextColor3 = Color3.fromRGB(0, 255, 80)
        else
            IsLocked = false
            TargetPlr = nil
            label.Text = "Target lost | Press key again"
            label.TextColor3 = Color3.fromRGB(255, 100, 100)
            marker.Visible = false
        end
    end
end))

-- RENDERSTEP: Marker-Update
table.insert(Connections, RunService.RenderStepped:Connect(function()
    if IsLocked and IsTargetValid() then
        local predPos = GetPredictedPosition()
        if predPos then
            local screenPos, onScreen = Camera:WorldToViewportPoint(predPos)
            marker.Visible = onScreen
            if onScreen then
                marker.Position = UDim2.fromOffset(screenPos.X - 6.5, screenPos.Y - 6.5)
            end
        end
    else
        marker.Visible = false
    end
end))

-- METAMETHOD HOOK: Schießt immer auf die vorhergesagte Position
local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if not checkcaller() and IsLocked and self == Mouse then
        if key == "Hit" then
            local predicted = GetPredictedPosition()
            if predicted then
                return CFrame.new(predicted)
            end
        elseif key == "Target" then
            if IsTargetValid() then
                return TargetPlr.Character:FindFirstChild(getgenv().HitPart)
            end
        end
    end
    return oldIndex(self, key)
end))

getgenv().SilentAim_Q_Destroy = function()
    for _, c in pairs(Connections) do pcall(function() c:Disconnect() end) end
    if gui then gui:Destroy() end
    VelocityHistory = {}
    getgenv().SilentAim_Q_Destroy = nil
end
