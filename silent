local function IsPlayerValid(plr)
    if plr and plr.Character and plr.Character:FindFirstChild('HumanoidRootPart') and plr.Character:FindFirstChild('Humanoid') and plr.Character:FindFirstChild('Head') then
        return true
    end
    return false
end

local function CheckGun()
    local char = LP.Character
    if not char then return false end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return false end
    if tool:FindFirstChild("Handle") and not tool.Name:lower():find("wallet") and not tool.Name:lower():find("phone") then
        return true
    end
    return false
end

local function IsVisible(Part, PartDescendant)
    if not getgenv().Looten.Adjustment.Checks.Wall_Check then return true end
    
    local Character = Client.Character or Client.CharacterAdded:Wait()
    local Origin = Camera.CFrame.Position
    local _, OnScreen = Camera:WorldToViewportPoint(Part.Position)

    if OnScreen then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = { Character, Camera }

        local Result = Workspace:Raycast(Origin, Part.Position - Origin, raycastParams)

        if Result then
            local PartHit = Result.Instance
            local Visible = (not PartHit or PartHit:IsDescendantOf(PartDescendant))
            return Visible
        end
    end
    return false
end

local function GetClosestBodyPart(character)
    local ClosestDistance = math.huge
    local BodyPart = nil
    
    if character then
        for _, x in pairs(character:GetChildren()) do
            if x:IsA("BasePart") and (x.Name == "Head" or x.Name == "HumanoidRootPart" or x.Name == "UpperTorso" or x.Name == "LowerTorso") then
                local Position, OnScreen = Camera:WorldToViewportPoint(x.Position)
                if OnScreen then
                    local Distance = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(Position.X, Position.Y)).Magnitude
                    if Distance < ClosestDistance then
                        ClosestDistance = Distance
                        BodyPart = x
                    end
                end
            end
        end
    end
    return BodyPart
end

local function GetBestTargetLooten()
    local FoundTarget, Closest = nil, math.huge
    local MousePos = UserInputService:GetMouseLocation()

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= Client and v.Character and v.Character:FindFirstChild('HumanoidRootPart') then
            local char = v.Character
            
            if getgenv().Looten.Adjustment.Checks.Knocked_Check then
                local be = char:FindFirstChild("BodyEffects")
                if be and be:FindFirstChild("K.O") and be["K.O"].Value then continue end
                if char:FindFirstChild("GRABBING_CONSTRAINT") then continue end
            end

            local AimPart = char.HumanoidRootPart
            if IsVisible(AimPart, char) then
                local Pos, OnScreen = Camera:WorldToViewportPoint(AimPart.Position)
                if OnScreen then
                    local Distance = (Vector2.new(MousePos.X, MousePos.Y) - Vector2.new(Pos.X, Pos.Y)).Magnitude
                    if Distance < Closest and Distance <= getgenv().Looten.Fov.SilentAim.Radius then
                        Closest = Distance
                        FoundTarget = v
                    end
                end
            end
        end
    end
    return FoundTarget
end

local function CalculatePredictionLooten(TargetPlayer)
    if not IsPlayerValid(TargetPlayer) then return nil, nil end

    local TargetChar = TargetPlayer.Character
    local HitPartName = getgenv().Looten.Silent.HitPart.HitPart
    
    if getgenv().Looten.Silent.HitPart.NearestPoint then
        local nearest = GetClosestBodyPart(TargetChar)
        if nearest then HitPartName = nearest.Name end
    end

    local TargetPart = TargetChar:FindFirstChild(HitPartName)
    if not TargetPart then return nil, nil end

    local TargetCF = TargetPart.CFrame
    local TargetVel = TargetChar.HumanoidRootPart.Velocity
    local TargetMov = TargetChar.Humanoid.MoveDirection
    local SilentPos = TargetCF.Position

    local usePrediction = false
    if getgenv().DD then
        local mag = TargetVel.magnitude
        if mag > getgenv().DV then usePrediction = true
        elseif mag < 1 and TargetMov.magnitude > 0.01 then usePrediction = true
        elseif mag > 5 and TargetMov.magnitude < 0.01 then usePrediction = true
        end
    end

    if getgenv().Looten.Adjustment.Checks.NoGroundShots and TargetVel.Y < getgenv().WAGA then
        SilentPos = TargetCF.Position + (Vector3.new(TargetVel.X, (TargetVel.Y * getgenv().AGV), TargetVel.Z) * getgenv().Looten.Silent.Prediction.Prediction)
    elseif getgenv().DUG and TargetVel.Y < getgenv().UD then
        SilentPos = TargetCF.Position + (Vector3.new(TargetVel.X, 0, TargetVel.Z) * getgenv().Looten.Silent.Prediction.Prediction)
    elseif usePrediction or getgenv().Looten.Silent.Prediction.Enabled then
        SilentPos = TargetCF.Position + (TargetVel * getgenv().Looten.Silent.Prediction.Prediction)
    end

    return SilentPos, TargetPart
end



local function unlock()
    isLocked = false
    targetPlr = nil
    targetPart = nil
    predictionPos = nil
    label.Text = ""
    marker.Visible = false
end

local function toggleLock()
    if not (Shared.SilentAim and Shared.SilentAimMethod == "QMethod") then
        unlock()
        return
    end
    
    if isLocked then
        unlock()
    else
        -- HIER: Nutzt Looten Selector
        local t = GetBestTargetLooten()
        if t then
            isLocked = true
            targetPlr = t
            -- Initial part, wird im Loop geupdatet
            targetPart = t.Character.HumanoidRootPart 
            label.Text = "LOCKED: " .. t.Name
        end
    end
end

table.insert(Shared.Connections[key], RunService.RenderStepped:Connect(function()
    if not Shared.SilentAim or Shared.SilentAimMethod ~= "QMethod" then
        if isLocked then unlock() end
        gui.Enabled = false
        IsGunEquipped = false
        return
    end
    
    gui.Enabled = true
    IsGunEquipped = CheckGun()
    
    if not IsGunEquipped then
        predictionPos = nil
        marker.Visible = false
        return
    end
    
    if isLocked and targetPlr and IsPlayerValid(targetPlr) then
        local pPos, pPart = CalculatePredictionLooten(targetPlr)
        
        if pPos and pPart then
            predictionPos = pPos
            targetPart = pPart
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(predictionPos)
            if onScreen then
                marker.Visible = true
                marker.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
            else
                marker.Visible = false
            end
        else
            unlock()
        end
    else
        if isLocked then unlock() end
    end
end))

table.insert(Shared.Connections[key], UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then
        toggleLock()
    end
end))


local mt = getrawmetatable(game)
local oldNc = mt.__namecall
local oldIdx = mt.__index
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local m = getnamecallmethod()
    
    if IsGunEquipped and isLocked and predictionPos then
        if m == "Raycast" and self == Workspace then
            local a = {...}
            if a[1] and a[2] then
                -- Looten Logic: Redirect Raycast to Prediction Position
                return oldNc(self, a[1], (predictionPos - a[1]).Unit * a[2].Magnitude, unpack(a, 3))
            end
        end
        
        if self == CachedMouse then
            if m == "GetHit" then return CFrame.new(predictionPos) end
            if m == "GetTarget" then return targetPart end
        end
    end
    return oldNc(self, ...)
end)

mt.__index = newcclosure(function(self, k)
    if IsGunEquipped and isLocked and predictionPos then
        if self == CachedMouse then
            if k == "Hit" then return CFrame.new(predictionPos) end
            if k == "Target" then return targetPart end
            if k == "X" then return predictionPos.X end
            if k == "Y" then return predictionPos.Y end
            if k == "Z" then return predictionPos.Z end
        end
    end
    return oldIdx(self, k)
end)

setreadonly(mt, true)
